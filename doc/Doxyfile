# Configuracion de Doxygen para ctests.
#
# Genera documentacion HTML de la API a partir de los comentarios del header.
# Ejecutar desde la carpeta doc/:
#
#     cd doc && doxygen Doxyfile
#
# La salida queda en doc/doxygen_doc/html/index.html (ignorada por git).

PROJECT_NAME           = "ctests"
PROJECT_BRIEF          = "Libreria header-only de tests unitarios e integracion para C/C++"
PROJECT_NUMBER         = 1.0.0

# Rutas relativas a esta carpeta (doc/)
INPUT                  = ../ctests.h ../README.md
OUTPUT_DIRECTORY       = doxygen_doc
USE_MDFILE_AS_MAINPAGE = ../README.md

# Queremos ver tambien los elementos 'static' (todo el header lo es)
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES

# C/C++
OPTIMIZE_OUTPUT_FOR_C  = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# Salida
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
RECURSIVE              = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

# Codificacion
INPUT_ENCODING         = UTF-8
